# Sectors AI Advisor — Environment Variables
# Copy to .env.local and fill in your API keys
# Keys set here are used by the optional server proxy routes (/api/chat, /api/sectors).
# The default UI flow uses the keys entered in Settings (browser localStorage).

# Sectors API Key (get yours at https://sectors.app)
SECTORS_API_KEY=your_sectors_api_key_here

# LLM Provider API Keys
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
